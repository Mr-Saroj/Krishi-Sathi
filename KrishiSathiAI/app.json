{
  "expo": {
    "name": "KrishiSathi AI",
    "slug": "KrishiSathiAI",
    "scheme": "krishisathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_logo1.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app_logo1.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/app_logo1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video"
    ]
  }
}
