{
  "expo": {
    "name": "KrishiSathi AI",
    "slug": "KrishiSathiAI",
    "scheme": "krishisathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_logo1.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app_logo1.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/app_logo1.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mrsaroj.KrishiSathiAI"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "KrishiSathi AI needs the camera to scan crop problems."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03e67f9a-b070-49ff-a16b-aa83b49f3f67"
      }
    }
  }
}
